<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.SmartPantryManager">

        <activity android:name=".MainActivity" android:exported="true" android:label="My Pantry">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".AddEditActivity" android:label="Ingredient"
            android:parentActivityName=".MainActivity" />
        <activity android:name=".RecipesActivity" android:label="Suggested Recipes"
            android:parentActivityName=".MainActivity" />
        <activity android:name=".RecipeDetailActivity" android:label="Recipe Details"
            android:parentActivityName=".RecipesActivity" />
        <activity android:name=".SettingsActivity" android:label="Settings"
            android:parentActivityName=".MainActivity" />
    </application>
</manifest>