<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_margin="8dp"
    app:cardCornerRadius="8dp" app:cardElevation="2dp">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:padding="16dp" android:gravity="center_vertical">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/tv_name" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="18sp" android:textStyle="bold"/>
            <TextView android:id="@+id/tv_qty" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/text_secondary"/>
        </LinearLayout>
        <TextView android:id="@+id/btn_edit" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Edit" android:padding="8dp" android:textColor="#1976D2"/>
        <TextView android:id="@+id/btn_delete" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Delete" android:padding="8dp" android:textColor="#D32F2F"/>
    </LinearLayout>
</androidx.cardview.widget.CardView>