<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/background">

    <TextView android:id="@+id/tv_title" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Settings" android:textSize="24sp" android:textStyle="bold" android:textColor="@color/primary" android:padding="16dp"
        app:layout_constraintTop_toTopOf="parent"/>

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="App Version 1.0\nProfile: Student Mode" android:padding="24dp"
        app:layout_constraintTop_toBottomOf="@id/tv_title"/>

    <com.google.android.material.bottomnavigation.BottomNavigationView android:id="@+id/bottom_nav"
        android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@color/white"
        app:menu="@menu/bottom_nav_menu" app:layout_constraintBottom_toBottomOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>